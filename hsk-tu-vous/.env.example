# Gemini API is the production provider for TTS and word-timed transcription.
# Requests send episode narration and generated audio to Google. Keep keys in .env.local.
# Optional backups are tried after HTTP 429; use different Google projects for independent project quotas.
HSK_AI_ALLOW_GEMINI_API=false
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
