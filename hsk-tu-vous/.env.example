# Safe legacy default. Gemini Direct can be selected explicitly after A/B testing.
HSK_AI_VOICE_API_PROVIDER=openrouter
OPENROUTER_API_KEY=

# For Gemini Direct first + OpenRouter automatic backup on provider availability
# errors (HTTP 429 and transient HTTP 5xx), set all THREE settings below in a
# secure .env.local or CI secrets/variables, not in Git source:
# HSK_AI_VOICE_API_PROVIDER=gemini-direct
# HSK_AI_ALLOW_GEMINI_API=true
# HSK_AI_OPENROUTER_FALLBACK_ENABLED=true
#
# The last flag authorizes OpenRouter usage/billing during real production.
# Configure your own OpenRouter spend limit BEFORE enabling it. It does not
# rotate Google project credentials to evade their per-project quota.
HSK_AI_ALLOW_GEMINI_API=false
HSK_AI_OPENROUTER_FALLBACK_ENABLED=false
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP_1=
GEMINI_API_KEY_BACKUP_2=
GEMINI_API_KEY_BACKUP_3=
