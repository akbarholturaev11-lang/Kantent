# Primary voice API transport. OpenRouter routes the approved Gemini models.
HSK_AI_VOICE_API_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Secondary manual transport: set HSK_AI_VOICE_API_PROVIDER=gemini-direct
# and explicitly allow direct Google API usage, using an existing Gemini API key.
# Never put actual API keys in source control.
HSK_AI_ALLOW_GEMINI_API=false
GEMINI_API_KEY=
