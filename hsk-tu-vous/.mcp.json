{
  "mcpServers": {
    "hsk-ai-content": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/mcp-server.mjs"]
    },
    "heroui-native": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@heroui/native-mcp@latest"]
    },
    "heroui-react": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@heroui/react-mcp@latest"]
    }
  }
}
